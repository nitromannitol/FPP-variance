module

public import IsotropicVariance.Paper.Proofs.Bridge.Statements
public import IsotropicVariance.Paper.Proofs.Bridge.Pullback
public import IsotropicVariance.Paper.Proofs.Bridge.Factorization
public import IsotropicVariance.Infra.WhiteNoiseProps.Interface
public import IsotropicVariance.Infra.Instances.WhiteJoint
public import IsotropicVariance.Infra.Instances.Passage

/-!
# The white-noise setting on the canonical carrier

The carrier is the space of configurations `WhiteNoiseConfig (Pt m)` itself, with its
cylinder σ-algebra and the law `Q = P ∘ W⁻¹` of the white noise. Under `Q` the identity is a
white noise, so the white-noise properties give the fields of the interface:
- the information of `S`: `Paper.Noise.info`, generated by the tests supported in `S`;
- independence and the union law: `paper_iIndep_info`, `paper_union_ae`;
- the action: `whiteAct g ν = ν(· ∘ g)`, law-preserving by `rigidMotion_law_eq`,
  with information moved by `comap_info_act`;
- the density is the given density itself: `determined` from `measurable_density_closedBall`,
  `determined_joint` from `Infra.Instances.measurable_white_density_joint`, bounds and covariance
  from `IsLocalDensity`.

The passage time of the setting at `W ω` is the passage time of the data at `ω`, so the laws of
the passage times `T(u, v)` agree (`whiteBridgeStatement_of_standardBorel`). The standard Borel
structure of the carrier is the one remaining input, taken here as a hypothesis.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set TopologicalSpace
open scoped Distributions

universe u

namespace IsotropicVariance.Paper.Proofs.Bridge

variable {m : ℕ}

/-- Under the law of a white noise, the identity of the configurations is a white noise. -/
theorem isWhiteNoise_id_map {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {W : Ω → WhiteNoiseConfig (Pt m)} (hW : IsWhiteNoise W P) :
    IsWhiteNoise (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m)) (P.map W) := by
  refine ⟨measurable_id, fun φ => ⟨(Infra.Example.measurable_whiteNoise_eval φ).aemeasurable, ?_⟩⟩
  change (P.map W).map (fun ν : WhiteNoiseConfig (Pt m) => ν φ) = _
  rw [Measure.map_map (Infra.Example.measurable_whiteNoise_eval φ) hW.1]
  exact (hW.2 φ).map_eq

/-- **The white-noise model on the canonical carrier**, for a law `Q` under which the identity is
a white noise. -/
noncomputable def whiteNoiseModel [StandardBorelSpace (WhiteNoiseConfig (Pt m))]
    (Q : Measure (WhiteNoiseConfig (Pt m))) [IsProbabilityMeasure Q]
    (hQ : IsWhiteNoise (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m)) Q) :
    NoiseModel.{0} m where
  Ω := WhiteNoiseConfig (Pt m)
  P := Q
  info := Paper.Noise.info Paper.Noise.white
  info_le _ := iSup₂_le fun φ _ => (Infra.Example.measurable_whiteNoise_eval φ).comap_le
  info_mono _ _ hST := iSup₂_le fun φ hφ => le_iSup₂_of_le φ (hφ.trans hST) le_rfl
  iIndep_info ι _ S hB hb hd := by
    simpa only [MeasurableSpace.comap_id] using
      Infra.WhiteNoiseProps.paper_iIndep_info hQ ι S hB hb hd
  union_ae S hB hb hd A hA := by
    have h := Infra.WhiteNoiseProps.paper_union_ae hQ S hB hb hd A
      (by rwa [MeasurableSpace.comap_id])
    have hsup : (⨆ k, (Paper.Noise.info Paper.Noise.white (S k)).comap
        (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m))) =
        ⨆ k, Paper.Noise.info Paper.Noise.white (S k) :=
      iSup_congr fun _ => MeasurableSpace.comap_id
    rw [hsup] at h
    exact h
  act := whiteAct
  measurePreserving_act g _ := ⟨measurable_whiteAct g, by
    rw [Infra.WhiteNoiseProps.rigidMotion_law_eq (V := whiteAct g) hQ g
      (fun ν => isMovedBy_whiteAct g ν), Measure.map_id]⟩
  comap_info_act g _ S := by
    have h := Infra.WhiteNoiseProps.comap_info_act
      (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m)) g (whiteAct g)
      (fun ν => isMovedBy_whiteAct g ν) S
    have h1 := Infra.WhiteNoiseProps.paper_info_comap_eq
      (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m)) (g '' S)
    have h2 := Infra.WhiteNoiseProps.paper_info_comap_eq
      (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m)) S
    rw [MeasurableSpace.comap_id] at h1 h2
    rw [h1, h2]
    exact h

/-- **The white-noise setting on the canonical carrier**: the model `whiteNoiseModel` with the
given density. -/
noncomputable def whiteSetting [StandardBorelSpace (WhiteNoiseConfig (Pt m))]
    (Q : Measure (WhiteNoiseConfig (Pt m))) [IsProbabilityMeasure Q]
    (hQ : IsWhiteNoise (id : WhiteNoiseConfig (Pt m) → WhiteNoiseConfig (Pt m)) Q)
    (ρ : WhiteNoiseConfig (Pt m) → Pt m → ℝ)
    (hρ : IsLocalDensity WhiteNoiseConfig.AgreeOn WhiteNoiseConfig.IsMovedBy ρ) :
    Setting.{0} m where
  toNoiseModel := whiteNoiseModel Q hQ
  ρ := ρ
  measurable_ρ := hρ.measurable
  determined := measurable_density_closedBall hρ
  determined_joint := Infra.Instances.measurable_white_density_joint hρ
  bounds := hρ.bounds
  covariant g hg ν x := hρ.covariant g hg ν (whiteAct g ν) (isMovedBy_whiteAct g ν) x

/-- **The bridge for white noise**, given the standard Borel structure of the configurations. -/
theorem whiteBridgeStatement_of_standardBorel
    (hsb : ∀ m : ℕ, StandardBorelSpace (WhiteNoiseConfig (Pt m))) :
    WhiteBridgeStatement.{u} := by
  intro m Ω _ _ P _ W hW ρ hρ
  have := hsb m
  have hQ := isWhiteNoise_id_map hW
  have : IsProbabilityMeasure (P.map W) :=
    (Measure.isProbabilityMeasure_map_iff hW.1.aemeasurable).2 inferInstance
  refine ⟨whiteSetting (P.map W) hQ ρ hρ, fun u v => ?_⟩
  let X : Realization.{u} m :=
    { noise := .white, Ω := Ω, P := P, config := W, isLaw := hW, ρ := ρ, isLocalDensity := hρ }
  let X₀ : Realization.{0} m :=
    { noise := .white, Ω := WhiteNoiseConfig (Pt m), P := P.map W, config := id, isLaw := hQ,
      ρ := ρ, isLocalDensity := hρ }
  have hX : AEMeasurable (fun ω => passageTime (ρ (W ω)) u v) P :=
    Infra.Instances.realization_passageTime_aemeasurable X u v
  have hS : AEMeasurable (fun ω => (whiteSetting (P.map W) hQ ρ hρ).passTime ω u v) (P.map W) :=
    Infra.Instances.realization_passageTime_aemeasurable X₀ u v
  refine ⟨hX, hS, ?_⟩
  change P.map _ = (P.map W).map (fun ω => (whiteSetting (P.map W) hQ ρ hρ).passTime ω u v)
  exact (AEMeasurable.map_map_of_aemeasurable hS hW.1.aemeasurable).symm

end IsotropicVariance.Paper.Proofs.Bridge
