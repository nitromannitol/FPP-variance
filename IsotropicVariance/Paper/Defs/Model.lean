module

public import IsotropicVariance.Paper.Defs.SurfaceDefs

/-!
# The setting: the data of the main theorems, the noise interface, the density

The setting of Sections `ssec:general` to `sec:completion`:
* `Noise`, `Realization`: the data of the main theorems (one of the two noises of Assumption
  `ass:local`, Gaussian white noise or a homogeneous Poisson process, realized on a standard Borel
  probability space as in Section `ssec:general`, and a density satisfying `IsLocalDensity`), with
  the configuration spaces, restrictions, motions and information σ-algebras of the two noises.
* `NoiseModel`: the noise interface every intermediate result is stated over: information
  σ-algebras of sets, independence over Borel sets with null boundaries and disjoint interiors, the
  union law up to null sets for partitions into such sets, and a measure-preserving action of
  proper rigid motions moving the information.
* `Setting`: the interface with a density satisfying Assumption `ass:local` over it, with part (1)
  of the assumption also in the joint form that being determined by the noise in a region needs (the
  density at the points whose unit ball lies in an open set `U` is jointly measurable for the
  information of `U` and the Borel sets), and its passage times, means, normalization and upper
  bounds. The bridge from `Realization` to `Setting` is the statement
  `SettingOfRealizationStatement`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Set TopologicalSpace
open scoped NNReal ENNReal Topology Distributions

universe u

namespace IsotropicVariance.Paper

/-- The direction `e₁` is a unit vector. -/
theorem norm_e₁ {m : ℕ} : ‖(e₁ : Pt m)‖ = 1 := by
  simp only [e₁, WithLp.norm_toLp_fst, norm_one]

/-- The two noises of Assumption `ass:local`: Gaussian white noise, and the
homogeneous Poisson process of intensity `lam` (a realization requires `0 < lam`). -/
inductive Noise : Type where
  /-- Gaussian white noise. -/
  | white
  /-- The homogeneous Poisson process of intensity `lam`. -/
  | poisson (lam : ℝ≥0)

namespace Noise

/-- The configuration space of the noise on `ℝ^d`, `d = m + 1`: distributions for white noise,
measures for the Poisson process (`WhiteNoiseConfig`, `Measure`). -/
abbrev Config (m : ℕ) : Noise → Type
  | white => WhiteNoiseConfig (Pt m)
  | poisson _ => Measure (Pt m)

/-- The σ-algebra of configurations: generated by the evaluations at test functions (white
noise, `WhiteNoiseConfig.instMeasurableSpace`), the Giry σ-algebra (Poisson). -/
noncomputable instance instMeasurableSpace (m : ℕ) : (k : Noise) → MeasurableSpace (k.Config m)
  | white => inferInstanceAs (MeasurableSpace (WhiteNoiseConfig (Pt m)))
  | poisson _ => inferInstanceAs (MeasurableSpace (Measure (Pt m)))

/-- Two configurations have the same restriction to `S` (`WhiteNoiseConfig.AgreeOn`,
`PoissonConfig.AgreeOn`). -/
def agree {m : ℕ} : (k : Noise) → Set (Pt m) → k.Config m → k.Config m → Prop
  | white => WhiteNoiseConfig.AgreeOn
  | poisson _ => PoissonConfig.AgreeOn

/-- `c'` is the configuration `c` moved by the rigid motion `g` (`WhiteNoiseConfig.IsMovedBy`,
`PoissonConfig.IsMovedBy`). -/
def moved {m : ℕ} : (k : Noise) → (Pt m ≃ᵃⁱ[ℝ] Pt m) → k.Config m → k.Config m → Prop
  | white => WhiteNoiseConfig.IsMovedBy
  | poisson _ => PoissonConfig.IsMovedBy

/-- The information of the noise in `S`: the σ-algebra on configurations generated by the
evaluations at test functions supported in `S` (white noise), by the counts of Borel subsets of
`S` (Poisson). Being determined by the noise in `S` means measurable for it (Section `ssec:general`
and Lemma `lem:labels`). -/
@[instance_reducible]
noncomputable def info {m : ℕ} : (k : Noise) → Set (Pt m) → MeasurableSpace (k.Config m)
  | white, S => ⨆ (φ : 𝓓((⊤ : Opens (Pt m)), ℝ)) (_ : tsupport ⇑φ ⊆ S),
      (inferInstance : MeasurableSpace ℝ).comap fun ν : WhiteNoiseConfig (Pt m) => ν φ
  | poisson _, S => ⨆ (B : Set (Pt m)) (_ : MeasurableSet B) (_ : B ⊆ S),
      (inferInstance : MeasurableSpace ℝ≥0∞).comap fun μ : Measure (Pt m) => μ B

/-- `ν` is a realization of the noise under `P`: white noise (`IsWhiteNoise`), or a Poisson
process of positive intensity (`IsPoissonProcess`). -/
def IsLaw {m : ℕ} : (k : Noise) → {Ω : Type*} → [MeasurableSpace Ω] → (Ω → k.Config m) →
    Measure Ω → Prop
  | white, _, _, ν, P => IsWhiteNoise ν P
  | poisson lam, _, _, ν, P => 0 < lam ∧ IsPoissonProcess lam ν P

end Noise

/-- A realization of the setting of Theorem `thm:general`: one of the two noises, realized on a
standard Borel probability space, and a density `ρ(c, x)` of the noise configuration `c`
satisfying Assumption `ass:local` (`IsLocalDensity`). The main theorems are statements about
exactly these data. -/
structure Realization (m : ℕ) : Type (u + 1) where
  /-- The noise. -/
  noise : Noise
  /-- The probability space. -/
  Ω : Type u
  [measurableSpace : MeasurableSpace Ω]
  [standardBorelSpace : StandardBorelSpace Ω]
  /-- The probability. -/
  P : Measure Ω
  [isProbabilityMeasure : IsProbabilityMeasure P]
  /-- The noise configuration. -/
  config : Ω → noise.Config m
  /-- The configuration has the law of the noise. -/
  isLaw : noise.IsLaw config P
  /-- The density, a function of the configuration and the point. -/
  ρ : noise.Config m → Pt m → ℝ
  /-- Assumption `ass:local`. -/
  isLocalDensity : IsLocalDensity noise.agree noise.moved ρ

attribute [instance] Realization.measurableSpace Realization.standardBorelSpace
  Realization.isProbabilityMeasure

namespace Realization

variable {m : ℕ} (X : Realization.{u} m)

/-- The random passage time `T_t = T(0, t e₁)` of a realization. -/
noncomputable def TRV (t : ℝ) (ω : X.Ω) : ℝ :=
  passageTime (X.ρ (X.config ω)) 0 (t • e₁)

end Realization

/-! ## The noise interface the proofs consume -/

/-- **The noise interface**: a standard Borel probability space with the information `info S` of
the noise in each set `S` (Sections `ssec:general` and `sec:gain`), independence over
Borel sets with null boundaries and pairwise disjoint interiors (without the null boundaries, a
fat Cantor set is a set with empty interior whose Poisson count is not independent of itself),
the union law up to null sets for countable partitions into Borel sets with null boundaries, and a
measure-preserving action of proper rigid motions under which the information of `g '' S` pulls
back to the information of `S`. Every intermediate result is stated over this interface; the two
noises are instances. -/
structure NoiseModel (m : ℕ) : Type (u + 1) where
  /-- The probability space. -/
  Ω : Type u
  [measurableSpace : MeasurableSpace Ω]
  [standardBorelSpace : StandardBorelSpace Ω]
  /-- The probability. -/
  P : Measure Ω
  [isProbabilityMeasure : IsProbabilityMeasure P]
  /-- The information of the noise in `S`. -/
  info : Set (Pt m) → MeasurableSpace Ω
  /-- Information is information about the outcome. -/
  info_le : ∀ S, info S ≤ measurableSpace
  /-- More space, more information. -/
  info_mono : ∀ ⦃S T : Set (Pt m)⦄, S ⊆ T → info S ≤ info T
  /-- Independence over Borel sets with null boundaries and pairwise disjoint interiors. -/
  iIndep_info : ∀ (ι : Type) [Countable ι] (S : ι → Set (Pt m)), (∀ i, MeasurableSet (S i)) →
    (∀ i, volume (frontier (S i)) = 0) →
    Pairwise (Function.onFun Disjoint fun i => interior (S i)) → iIndep (fun i => info (S i)) P
  /-- The union law, up to null sets, for pairwise disjoint Borel sets with null boundaries. -/
  union_ae : ∀ S : ℕ → Set (Pt m), (∀ k, MeasurableSet (S k)) →
    (∀ k, volume (frontier (S k)) = 0) → Pairwise (Function.onFun Disjoint S) →
    ∀ A : Set Ω, MeasurableSet[info (⋃ k, S k)] A →
      ∃ B : Set Ω, MeasurableSet[⨆ k, info (S k)] B ∧ P (symmDiff A B) = 0
  /-- The action of rigid motions on the noise. -/
  act : (Pt m ≃ᵃⁱ[ℝ] Pt m) → Ω → Ω
  /-- Proper rigid motions preserve the law of the noise. -/
  measurePreserving_act : ∀ g, IsProperRigidMotion g → MeasurePreserving (act g) P P
  /-- Moving the noise by `g` moves its information: the noise of `act g ω` in `g '' S` is the
  noise of `ω` in `S`. -/
  comap_info_act : ∀ g, IsProperRigidMotion g → ∀ S, (info (g '' S)).comap (act g) = info S

attribute [instance] NoiseModel.measurableSpace NoiseModel.standardBorelSpace
  NoiseModel.isProbabilityMeasure

/-- **The setting of Sections `ssec:general` to `sec:completion`**: the noise interface and a
density `ρ(ω, x)` satisfying Assumption `ass:local` over it: jointly measurable, determined at `x`
by the information of the closed unit ball around `x`, and jointly: on the points whose closed
unit ball lies in an open set `U`, jointly measurable for the information of `U` and the Borel
sets (without this, `determined` and `measurable_ρ` do not make the passage times of disjoint slabs
independent: a density read off a Poisson line process with trivial information satisfies both),
between two positive constants, and covariant under proper rigid motions.

The paper's "unit ball centered at `x`" is read as the closed ball, as in "the noise within unit
distance" of the introduction, and covariance is required only for proper rigid motions
(translations and rotations), the only ones the proofs use. Both readings weaken the hypothesis.
-/
structure Setting (m : ℕ) extends NoiseModel.{u} m where
  /-- The density. -/
  ρ : Ω → Pt m → ℝ
  /-- Joint measurability. -/
  measurable_ρ : Measurable (Function.uncurry ρ)
  /-- Part (1) of Assumption `ass:local`. -/
  determined : ∀ x : Pt m, Measurable[info (Metric.closedBall x 1)] fun ω => ρ ω x
  /-- Part (1) of Assumption `ass:local`, jointly over the points whose closed unit ball lies in
  an open set. -/
  determined_joint : ∀ U : Set (Pt m), IsOpen U →
    Measurable[(info U).prod inferInstance]
      fun p : Ω × {x : Pt m // Metric.closedBall x 1 ⊆ U} => ρ p.1 p.2
  /-- Part (2) of Assumption `ass:local`. -/
  bounds : ∃ a b : ℝ, 0 < a ∧ ∀ ω x, a ≤ ρ ω x ∧ ρ ω x ≤ b
  /-- Part (3) of Assumption `ass:local`. -/
  covariant : ∀ g : Pt m ≃ᵃⁱ[ℝ] Pt m, IsProperRigidMotion g → ∀ ω x, ρ (act g ω) (g x) = ρ ω x

namespace Setting

variable {m : ℕ} (X : Setting.{u} m)

/-- The passage time `T(u, v)` of an outcome (the introduction; `passageTime`). -/
noncomputable def passTime (ω : X.Ω) (u v : Pt m) : ℝ :=
  passageTime (X.ρ ω) u v

/-- `T_t = T(0, t e₁)` (Section `ssec:overview`). -/
noncomputable def TRV (t : ℝ) (ω : X.Ω) : ℝ :=
  X.passTime ω 0 (t • e₁)

/-- The mean `E T_t`. -/
noncomputable def mean (t : ℝ) : ℝ :=
  ∫ ω, X.TRV t ω ∂X.P

/-- The density is normalized by the time constant, `μ = 1` (Section `ssec:overview`):
`E T_t / t → 1`. -/
def IsNormalized : Prop :=
  Tendsto (fun t : ℝ => X.mean t / t) atTop (𝓝 1)

/-- A fixed deterministic upper bound of the density (`sup ρ` of equation `eq:slabtime`). -/
def IsUpperBound (b : ℝ) : Prop :=
  ∀ ω x, X.ρ ω x ≤ b

/-- The same setting with the density replaced by `ρ'` (the normalization of Section
`ssec:overview`). -/
def withDensity (ρ' : X.Ω → Pt m → ℝ) (h₁ : Measurable (Function.uncurry ρ'))
    (h₂ : ∀ x : Pt m, Measurable[X.info (Metric.closedBall x 1)] fun ω => ρ' ω x)
    (h₂' : ∀ U : Set (Pt m), IsOpen U →
      Measurable[(X.info U).prod inferInstance]
        fun p : X.Ω × {x : Pt m // Metric.closedBall x 1 ⊆ U} => ρ' p.1 p.2)
    (h₃ : ∃ a b : ℝ, 0 < a ∧ ∀ ω x, a ≤ ρ' ω x ∧ ρ' ω x ≤ b)
    (h₄ : ∀ g : Pt m ≃ᵃⁱ[ℝ] Pt m, IsProperRigidMotion g →
      ∀ ω x, ρ' (X.act g ω) (g x) = ρ' ω x) :
    Setting.{u} m :=
  ⟨X.toNoiseModel, ρ', h₁, h₂, h₂', h₃, h₄⟩

end Setting

end IsotropicVariance.Paper
