module

public import IsotropicVariance.Infra.WhiteNoiseProps.Covariance
import Mathlib.Probability.Distributions.Gaussian.IsGaussianProcess.Independence

/-!
# Independent white-noise information on regions with disjoint interiors

Information is generated by evaluations at test functions supported in the region. Their
nonzero sets lie in its interior, so disjoint interiors imply zero cross covariance.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set TopologicalSpace
open scoped Distributions ENNReal

namespace IsotropicVariance.Infra.WhiteNoiseProps

open Example

/-- Test functions whose topological supports lie in a specified region. -/
abbrev SupportedTests {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (S : Set E) :=
  {φ : 𝓓((⊤ : Opens E), ℝ) // tsupport ⇑φ ⊆ S}

/-- Information on `S` is the sigma-algebra generated by the supported test evaluations. -/
@[instance_reducible]
noncomputable def info {E Ω : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (W : Ω → WhiteNoiseConfig E) (S : Set E) : MeasurableSpace Ω :=
  ⨆ φ : SupportedTests S, (inferInstance : MeasurableSpace ℝ).comap (fun ω => W ω φ.val)

/-- Regional sample information is the pullback of the corresponding configuration information. -/
theorem info_eq_comap {E Ω : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (W : Ω → WhiteNoiseConfig E) (S : Set E) :
    info W S = (⨆ (φ : 𝓓((⊤ : Opens E), ℝ)) (_ : tsupport ⇑φ ⊆ S),
      (inferInstance : MeasurableSpace ℝ).comap (fun ν : WhiteNoiseConfig E => ν φ)).comap W := by
  simp only [info, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp,
    Function.comp_def, iSup_subtype]

/-- The nonzero set of a supported continuous test function lies in the region's interior. -/
theorem support_subset_interior {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {S : Set E} (φ : SupportedTests S) : Function.support ⇑φ.val ⊆ interior S :=
  interior_maximal ((subset_tsupport _).trans φ.property)
    (isOpen_ne_fun φ.val.continuous continuous_const)

/-- Test functions supported in regions with disjoint interiors have zero pointwise product. -/
theorem test_mul_eq_zero {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {S T : Set E} (hST : Disjoint (interior S) (interior T))
    (φ : SupportedTests S) (ψ : SupportedTests T) (x : E) : φ.val x * ψ.val x = 0 := by
  by_cases hφ : φ.val x = 0
  · rw [hφ, zero_mul]
  · have hψ : ψ.val x = 0 := by
      by_contra hψ
      exact Set.disjoint_left.mp hST (support_subset_interior φ hφ) (support_subset_interior ψ hψ)
    rw [hψ, mul_zero]

/-- Supported evaluation processes on regions with pairwise disjoint interiors are independent. -/
theorem iIndepFun_supported_evaluations {E Ω ι : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [MeasureSpace E] [BorelSpace E]
    [IsLocallyFiniteMeasure (volume : Measure E)] [MeasurableSpace Ω]
    {W : Ω → WhiteNoiseConfig E} {P : Measure Ω} (h : IsWhiteNoise W P)
    (S : ι → Set E) (hd : Pairwise (fun i j => Disjoint (interior (S i)) (interior (S j)))) :
    iIndepFun (fun i ω (φ : SupportedTests (S i)) => W ω φ.val) P := by
  have hg : IsGaussianProcess
      (fun (p : (i : ι) × SupportedTests (S i)) ω => W ω p.2.val) P := by
    simpa only [Function.comp_def] using
      (isGaussianProcess h).comp_right (fun p : (i : ι) × SupportedTests (S i) => p.2.val)
  apply hg.iIndepFun_of_covariance_eq_zero
  · intro i φ
    exact (measurable_eval h φ.val).aemeasurable
  · intro i j hij φ ψ
    rw [covariance_eval h φ.val ψ.val]
    have heq : (fun x => φ.val x * ψ.val x) = 0 := by
      funext x
      exact test_mul_eq_zero (hd hij) φ ψ x
    rw [heq]
    exact integral_zero E ℝ

/-- Regional information sigma-algebras are jointly independent for disjoint interiors. -/
theorem iIndep_info {E Ω ι : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [MeasureSpace E] [BorelSpace E] [IsLocallyFiniteMeasure (volume : Measure E)]
    [MeasurableSpace Ω] {W : Ω → WhiteNoiseConfig E} {P : Measure Ω}
    (h : IsWhiteNoise W P) (S : ι → Set E)
    (hd : Pairwise (fun i j => Disjoint (interior (S i)) (interior (S j)))) :
    iIndep (info W ∘ S) P := by
  have hh := (iIndepFun_iff_iIndep _ _ _).mp (iIndepFun_supported_evaluations h S hd)
  simpa only [MeasurableSpace.pi, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp,
    Function.comp_def, info] using hh

end IsotropicVariance.Infra.WhiteNoiseProps
