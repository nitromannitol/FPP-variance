module

public import IsotropicVariance.Infra.WhiteNoiseProps.PartitionApprox
public import IsotropicVariance.Infra.WhiteNoiseProps.ProbabilityApprox

/-!
# The white-noise union law modulo null events

Information in a countable union of disjoint null-boundary pieces has an almost-everywhere
equal representative in the sigma-algebra generated by the pieces. This is the form required
by `Paper.NoiseModel.union_ae`, rather than an unsupported everywhere restriction or splice map.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set TopologicalSpace Filter
open scoped Distributions ENNReal Topology BigOperators

namespace IsotropicVariance.Infra.WhiteNoiseProps

open Example

/-- Null-boundary countable partitions generate the information of their union modulo null
events. -/
theorem union_ae {E Ω : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasureSpace E] [BorelSpace E]
    [IsLocallyFiniteMeasure (volume : Measure E)] [mΩ : MeasurableSpace Ω]
    {W : Ω → WhiteNoiseConfig E} {P : Measure Ω} (h : IsWhiteNoise W P)
    (S : ℕ → Set E) (hfront : ∀ i, volume (frontier (S i)) = 0)
    (hd : Pairwise (fun i j => Disjoint (S i) (S j)))
    (A : Set Ω) (hA : MeasurableSet[info W (⋃ i, S i)] A) :
    ∃ B : Set Ω, MeasurableSet[⨆ i, info W (S i)] B ∧ P (symmDiff A B) = 0 := by
  let m : MeasurableSpace Ω := ⨆ i, info W (S i)
  let : MeasurableSpace Ω := mΩ
  have hle : info W (⋃ i, S i) ≤ @aeInfo Ω mΩ P m := by
    apply iSup_le
    intro φ
    obtain ⟨ψ, hs, hb, he⟩ : ∃ ψ : ℕ → ℕ → 𝓓((⊤ : Opens E), ℝ),
        (∀ i n, tsupport ⇑(ψ i n) ⊆ interior (S i)) ∧
        (∀ i n x, |ψ i n x| ≤ |φ.val x|) ∧
        (∀ i x, x ∈ interior (S i) → ∀ᶠ n in atTop, ψ i n x = φ.val x) := by
      choose ψ hs hb he using (fun i => exists_open_cutoffs (isOpen_interior (s := S i)) φ.val)
      exact ⟨ψ, hs, hb, he⟩
    have hmeas (n) : Measurable[m] (fun ω => W ω (partitionTest ψ n)) := by
      have heq : (fun ω => W ω (partitionTest ψ n)) =
          (fun ω => ∑ i ∈ Finset.range (n + 1), W ω (ψ i n)) := by
        funext ω
        exact map_sum (W ω) (fun i => ψ i n) (Finset.range (n + 1))
      rw [heq]
      apply Finset.measurable_sum
      intro i _
      have hm : Measurable[info W (S i)] (fun ω => W ω (ψ i n)) :=
        Measurable.of_comap_le (le_iSup_of_le
          (⟨ψ i n, (hs i n).trans interior_subset⟩ : SupportedTests (S i)) le_rfl)
      exact hm.mono (le_iSup (fun j => info W (S j)) i) le_rfl
    have hsq := partitionTest_sq_integral_tendsto hd hfront φ.val φ.property ψ hs hb he
    have hprob := tendstoInMeasure_eval h (partitionTest ψ) φ.val hsq
    obtain ⟨f, hfm, hf⟩ := exists_measurable_of_tendstoInMeasure hmeas hprob
    exact (measurable_aeInfo_of_ae_eq hfm hf).comap_le
  exact aeInfo_representative (hle A hA)

end IsotropicVariance.Infra.WhiteNoiseProps
