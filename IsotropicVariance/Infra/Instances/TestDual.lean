import Mathlib.Analysis.LocallyConvex.WithSeminorms

/-!
# Compact seminorm bounds in locally convex duals

A continuous seminorm bounds a weakly compact set of continuous linear forms.
This gives a countable compact cover for duals whose topology is generated by
countably many seminorms, including compactly supported test-function blocks.
-/

@[expose] public section

open Set TopologicalSpace Topology MeasureTheory
open scoped Distributions NNReal

namespace IsotropicVariance.Infra.Instances

/-- A linear form dominated by a continuous seminorm is continuous. -/
theorem continuous_linearForm_of_le_seminorm {E : Type*} [AddCommGroup E]
    [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    (p : Seminorm ℝ E) (hp : Continuous p) (f : E →ₗ[ℝ] ℝ)
    (hf : ∀ x, ‖f x‖ ≤ p x) : Continuous f := by
  apply continuous_of_tendsto_nhds_zero f
  rw [tendsto_zero_iff_norm_tendsto_zero]
  exact squeeze_zero (fun x => norm_nonneg (f x)) hf (by simpa only [map_zero] using hp.tendsto 0)

/-- The weakly compact set of linear forms bounded by a continuous seminorm. -/
theorem isCompact_dual_seminormBound {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E]
    (p : Seminorm ℝ E) (hp : Continuous p) :
    IsCompact {f : WeakDual ℝ E | ∀ x, ‖f x‖ ≤ p x} := by
  let C : Set (E → ℝ) := {f | (∀ x, ‖f x‖ ≤ p x) ∧
    (∀ x y, f (x + y) = f x + f y) ∧ ∀ (a : ℝ) x, f (a • x) = a • f x}
  have hc (x : E) : Continuous (fun f : E → ℝ => f x) := continuous_apply x
  have hC : IsClosed C := by
    change IsClosed ({f : E → ℝ | ∀ x, ‖f x‖ ≤ p x} ∩
      ({f : E → ℝ | ∀ x y, f (x + y) = f x + f y} ∩
        {f : E → ℝ | ∀ (a : ℝ) x, f (a • x) = a • f x}))
    simp only [ofPred_forall]
    apply IsClosed.inter
    · exact isClosed_iInter fun x => isClosed_le (hc x).norm continuous_const
    · apply IsClosed.inter
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          isClosed_eq (hc (x + y)) ((hc x).add (hc y))
      · exact isClosed_iInter fun a => isClosed_iInter fun x =>
          isClosed_eq (hc (a • x)) ((hc x).const_smul a)
  have heq : ((fun f : WeakDual ℝ E => (f : E → ℝ)) ''
      {f : WeakDual ℝ E | ∀ x, ‖f x‖ ≤ p x}) = C := by
    ext f
    constructor
    · rintro ⟨g, hg, rfl⟩
      exact ⟨hg, fun x y => map_add g x y, fun a x => map_smul g a x⟩
    · rintro ⟨hb, ha, hs⟩
      let l : E →ₗ[ℝ] ℝ := {toFun := f, map_add' := ha, map_smul' := hs}
      exact ⟨(⟨l, continuous_linearForm_of_le_seminorm p hp l hb⟩ : E →L[ℝ] ℝ), hb, rfl⟩
  apply DFunLike.coe_injective.isEmbedding_induced.isCompact_iff.mpr
  rw [heq]
  have hcompact : IsCompact (Set.pi Set.univ (fun x : E => Set.Icc (-p x) (p x))) :=
    isCompact_univ_pi fun _ => isCompact_Icc
  exact hcompact.of_isClosed_subset hC (fun f hf x _ => abs_le.mp (hf.1 x))

/-- Evaluation on a fixed dense sequence of a separable real vector space. -/
noncomputable def dualEvaluationCode (E : Type*) [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [SeparableSpace E] (f : WeakDual ℝ E) (n : ℕ) : ℝ :=
  f (denseSeq E n)

/-- Countable evaluation is a Borel embedding for a dual of a separable space whose topology
is generated by countably many seminorms. -/
theorem measurableEmbedding_dualEvaluationCode {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E] [SeparableSpace E]
    (p : ℕ → Seminorm ℝ E) (hp : WithSeminorms p) :
    @MeasurableEmbedding (WeakDual ℝ E) (ℕ → ℝ) (borel (WeakDual ℝ E))
      inferInstance (dualEvaluationCode E) := by
  let : MeasurableSpace (WeakDual ℝ E) := borel (WeakDual ℝ E)
  have : BorelSpace (WeakDual ℝ E) := ⟨rfl⟩
  obtain ⟨e, he⟩ := exists_surjective_nat (Finset ℕ × ℕ)
  let q : ℕ → Seminorm ℝ E := fun n => ((e n).2 : ℝ≥0) • (e n).1.sup p
  let K : ℕ → Set (WeakDual ℝ E) := fun n => {f | ∀ x, ‖f x‖ ≤ q n x}
  have hK (n : ℕ) : IsCompact (K n) := by
    apply isCompact_dual_seminormBound
    exact (Seminorm.continuous_finsetSup (fun i _ => hp.continuous_seminorm i)).const_smul ((e n).2 : ℝ≥0)
  have hcover : (⋃ n, K n) = Set.univ := by
    ext f
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    obtain ⟨s, C, _, hC⟩ := Seminorm.bound_of_continuous hp
      f.toStrongDual.toLinearMap.toSeminorm ((map_continuous f).norm)
    obtain ⟨n, hn⟩ := exists_nat_gt (C : ℝ)
    obtain ⟨k, hk⟩ := he (s, n)
    refine ⟨k, fun x => ?_⟩
    change ‖f x‖ ≤ ((e k).2 : ℝ) * ((e k).1.sup p) x
    rw [hk]
    exact (hC x).trans (mul_le_mul_of_nonneg_right hn.le (apply_nonneg _ x))
  have hc : Continuous (dualEvaluationCode E) :=
    continuous_pi fun n => WeakDual.eval_continuous (denseSeq E n)
  have hi : Function.Injective (dualEvaluationCode E) := by
    intro f g h
    apply DFunLike.ext'
    exact (map_continuous f).ext_on (denseRange_denseSeq E) (map_continuous g)
      (Set.eqOn_range.mpr (funext (fun n => congrFun h n)))
  exact measurableEmbedding_of_compact_cover K hK hcover hc hi

/-- The weak dual of a separable countably seminormed real space is standard Borel. -/
theorem standardBorel_weakDual_withSeminorms {E : Type*} [AddCommGroup E] [Module ℝ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E] [SeparableSpace E]
    (p : ℕ → Seminorm ℝ E) (hp : WithSeminorms p) :
    @StandardBorelSpace (WeakDual ℝ E) (borel (WeakDual ℝ E)) := by
  let : MeasurableSpace (WeakDual ℝ E) := borel (WeakDual ℝ E)
  exact standardBorel_of_measurableEmbedding (measurableEmbedding_dualEvaluationCode p hp)

/-- Compactly supported smooth test-function blocks have standard Borel weak duals. -/
theorem standardBorel_testBlockDual {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] (K : Compacts E) :
    @StandardBorelSpace (WeakDual ℝ 𝓓_{K}(E, ℝ)) (borel (WeakDual ℝ 𝓓_{K}(E, ℝ))) := by
  have : SecondCountableTopology 𝓓_{K}(E, ℝ) := secondCountable_testBlock K
  exact standardBorel_weakDual_withSeminorms _
    (ContDiffMapSupportedIn.withSeminorms ℝ E ℝ ⊤ K)

end IsotropicVariance.Infra.Instances
