module

public import IsotropicVariance.Infra.Instances.PoissonLocality
public import IsotropicVariance.Infra.Instances.PoissonTransfer
public import IsotropicVariance.Infra.Poisson.Independence

/-!
# Poisson regional information and exact partition generation

Borel restrictions generate exactly the paper's count information. Countable Borel partitions
generate their union exactly, before taking any noise law or null completion.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace IsotropicVariance.Infra.Instances

/-- The paper's Poisson information is exactly the information generated by Borel restriction. -/
theorem poisson_info_eq_comap_restrict {m : ℕ} {lam : ℝ≥0} {S : Set (Pt m)}
    (hS : MeasurableSet S) : Paper.Noise.info (Paper.Noise.poisson lam) S =
      (inferInstance : MeasurableSpace (Measure (Pt m))).comap (fun μ => μ.restrict S) := by
  apply le_antisymm
  · apply iSup_le
    intro B
    apply iSup_le
    intro hB
    apply iSup_le
    intro hBS
    have hr : Measurable[(inferInstance : MeasurableSpace (Measure (Pt m))).comap
        (fun μ => μ.restrict S)] (fun μ : Measure (Pt m) => μ.restrict S) :=
      Measurable.of_comap_le le_rfl
    have hm : Measurable[(inferInstance : MeasurableSpace (Measure (Pt m))).comap
        (fun μ => μ.restrict S)] (fun μ : Measure (Pt m) => μ.restrict S B) :=
      (Measure.measurable_coe hB).comp hr
    have heq : (fun μ : Measure (Pt m) => μ.restrict S B) = (fun μ => μ B) := by
      funext μ
      rw [Measure.restrict_apply hB, inter_eq_left.mpr hBS]
    rw [heq] at hm
    exact hm.comap_le
  · exact (measurable_poisson_restrict (lam := lam) hS).comap_le

/-- Poisson configuration information is monotone in its spatial region. -/
theorem poisson_info_mono {m : ℕ} {lam : ℝ≥0} {S T : Set (Pt m)} (hST : S ⊆ T) :
    Paper.Noise.info (Paper.Noise.poisson lam) S ≤ Paper.Noise.info (Paper.Noise.poisson lam) T := by
  apply iSup_le
  intro B
  apply iSup_le
  intro hB
  apply iSup_le
  intro hBS
  exact le_iSup_of_le B (le_iSup_of_le hB (le_iSup_of_le (hBS.trans hST) le_rfl))

/-- Regional Poisson information is contained in the full Giry sigma-algebra. -/
theorem poisson_info_le {m : ℕ} {lam : ℝ≥0} (S : Set (Pt m)) :
    Paper.Noise.info (Paper.Noise.poisson lam) S ≤
      (inferInstance : MeasurableSpace (Measure (Pt m))) := by
  exact iSup_le fun B => iSup_le fun hB => iSup_le fun _ => (Measure.measurable_coe hB).comap_le

/-- Information on disjoint Borel pieces generates all information on their union exactly. -/
theorem poisson_info_union {m : ℕ} {lam : ℝ≥0} (S : ℕ → Set (Pt m))
    (hS : ∀ i, MeasurableSet (S i)) (hd : Pairwise (fun i j => Disjoint (S i) (S j))) :
    Paper.Noise.info (Paper.Noise.poisson lam) (⋃ i, S i) =
      ⨆ i, Paper.Noise.info (Paper.Noise.poisson lam) (S i) := by
  apply le_antisymm
  · apply iSup_le
    intro B
    apply iSup_le
    intro hB
    apply iSup_le
    intro hBS
    have hm (i) : Measurable[⨆ i, Paper.Noise.info (Paper.Noise.poisson lam) (S i)]
        (fun μ : Measure (Pt m) => μ (B ∩ S i)) := by
      apply Measurable.of_comap_le
      exact le_iSup_of_le i (le_iSup_of_le (B ∩ S i)
        (le_iSup_of_le (hB.inter (hS i)) (le_iSup_of_le inter_subset_right le_rfl)))
    have heq : (fun μ : Measure (Pt m) => μ B) = (fun μ => ∑' i, μ (B ∩ S i)) := by
      funext μ
      have hu : (⋃ i, B ∩ S i) = B := by
        rw [← inter_iUnion, inter_eq_left.mpr hBS]
      calc
        μ B = μ (⋃ i, B ∩ S i) := congrArg μ hu.symm
        _ = ∑' i, μ (B ∩ S i) := measure_iUnion
          (fun i j hij => (hd hij).mono inter_subset_right inter_subset_right)
          (fun i => hB.inter (hS i))
    rw [heq]
    have hsum : Measurable[⨆ i, Paper.Noise.info (Paper.Noise.poisson lam) (S i)]
        (fun μ : Measure (Pt m) => ∑' i, μ (B ∩ S i)) := by
      let : MeasurableSpace (Measure (Pt m)) := ⨆ i, Paper.Noise.info (Paper.Noise.poisson lam) (S i)
      exact Measurable.tsum hm
    exact hsum.comap_le
  · exact iSup_le fun i => poisson_info_mono (subset_iUnion S i)

/-- Pushforward to Euclidean coordinates transports a restriction to the image region. -/
theorem poisson_coordinates_restrict {m : ℕ} (μ : Measure (Pt m)) (S : Set (Pt m)) :
    (((μ.map (poissonCoordinates m)).restrict (poissonCoordinates m '' S)).map
      (poissonCoordinates m).symm) = μ.restrict S := by
  let e := (poissonCoordinates m).toMeasurableEquiv
  change ((μ.map e).restrict (e '' S)).map e.symm = μ.restrict S
  rw [e.restrict_map, Set.preimage_image_eq _ e.injective,
    Measure.map_map e.symm.measurable e.measurable]
  have heq : e.symm ∘ e = id := by funext x; exact e.symm_apply_apply x
  rw [heq, Measure.map_id]

/-- The Poisson predicate gives joint independence of restrictions to disjoint Borel sets. -/
theorem isPoissonProcess_iIndepFun_restrict {m : ℕ} {Ω ι : Type*} [MeasurableSpace Ω]
    {lam : ℝ≥0} {η : Ω → Measure (Pt m)} {P : Measure Ω}
    (h : IsotropicVariance.IsPoissonProcess lam η P) (S : ι → Set (Pt m))
    (hS : ∀ i, MeasurableSet (S i)) (hd : Pairwise (fun i j => Disjoint (S i) (S j))) :
    iIndepFun (fun i ω => (η ω).restrict (S i)) P := by
  let c := poissonCoordinates m
  have hm (i) : MeasurableSet (c '' S i) := c.toHomeomorph.measurableEmbedding.measurableSet_image.mpr (hS i)
  have hdis : Pairwise (fun i j => Disjoint (c '' S i) (c '' S j)) := by
    intro i j hij
    apply Set.disjoint_left.mpr
    rintro x ⟨y, hy, rfl⟩ ⟨z, hz, hzy⟩
    have hzy' : z = y := c.injective hzy
    exact Set.disjoint_left.mp (hd hij) hy (hzy' ▸ hz)
  have hh := ((isPoissonProcess_coordinates h).iIndepFun_restrict (fun i => c '' S i) hm hdis).comp
    (fun _ => fun μ => μ.map c.symm) (fun _ => Measure.measurable_map _ c.symm.continuous.measurable)
  have heq : (fun i => (fun μ => μ.map c.symm) ∘ (fun ω => ((η ω).map c).restrict (c '' S i))) =
      (fun i ω => (η ω).restrict (S i)) := by
    funext i ω
    exact poisson_coordinates_restrict (η ω) (S i)
  rwa [heq] at hh

/-- Rigid pushforward transports the paper's exact regional Poisson information. -/
theorem poisson_info_comap_motion {m : ℕ} {lam : ℝ≥0} (g : Pt m ≃ᵃⁱ[ℝ] Pt m)
    (S : Set (Pt m)) :
    (Paper.Noise.info (Paper.Noise.poisson lam) (g '' S)).comap (fun μ => μ.map g) =
      Paper.Noise.info (Paper.Noise.poisson lam) S := by
  apply le_antisymm
  · change (⨆ B : Set (Pt m), ⨆ _ : MeasurableSet B, ⨆ _ : B ⊆ g '' S,
      (inferInstance : MeasurableSpace ℝ≥0∞).comap (fun μ : Measure (Pt m) => μ B)).comap
        (fun μ : Measure (Pt m) => μ.map g) ≤ _
    rw [MeasurableSpace.comap_iSup]
    apply iSup_le
    intro B
    rw [MeasurableSpace.comap_iSup]
    apply iSup_le
    intro hB
    rw [MeasurableSpace.comap_iSup]
    apply iSup_le
    intro hBS
    rw [MeasurableSpace.comap_comp]
    have heq : (fun μ : Measure (Pt m) => μ B) ∘ (fun μ => μ.map g) =
        (fun μ : Measure (Pt m) => μ (g ⁻¹' B)) := by
      funext μ
      exact Measure.map_apply g.continuous.measurable hB
    rw [heq]
    have hsub : g ⁻¹' B ⊆ S := by
      intro x hx
      obtain ⟨y, hy, hyx⟩ := hBS hx
      exact g.injective hyx ▸ hy
    exact le_iSup_of_le (g ⁻¹' B) (le_iSup_of_le (g.continuous.measurable hB)
      (le_iSup_of_le hsub le_rfl))
  · apply iSup_le
    intro B
    apply iSup_le
    intro hB
    apply iSup_le
    intro hBS
    have hgm : MeasurableSet (g '' B) := g.toHomeomorph.measurableEmbedding.measurableSet_image.mpr hB
    have hm : Measurable[Paper.Noise.info (Paper.Noise.poisson lam) (g '' S)]
        (fun μ : Measure (Pt m) => μ (g '' B)) :=
      Measurable.of_comap_le (le_iSup_of_le (g '' B)
        (le_iSup_of_le hgm (le_iSup_of_le (Set.image_mono hBS) le_rfl)))
    have hmap : @Measurable (Measure (Pt m)) (Measure (Pt m))
        ((Paper.Noise.info (Paper.Noise.poisson lam) (g '' S)).comap (fun μ => μ.map g))
        (Paper.Noise.info (Paper.Noise.poisson lam) (g '' S)) (fun μ => μ.map g) :=
      Measurable.of_comap_le le_rfl
    have hcomp : Measurable[(Paper.Noise.info (Paper.Noise.poisson lam) (g '' S)).comap
        (fun μ : Measure (Pt m) => μ.map g)] (fun μ : Measure (Pt m) => μ.map g (g '' B)) := hm.comp hmap
    have heq : (fun μ : Measure (Pt m) => μ.map g (g '' B)) = (fun μ => μ B) := by
      funext μ
      rw [Measure.map_apply g.continuous.measurable hgm, Set.preimage_image_eq _ g.injective]
    rw [heq] at hcomp
    exact hcomp.comap_le

end IsotropicVariance.Infra.Instances
